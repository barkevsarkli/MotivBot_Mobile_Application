<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MotivBot" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!--
      Cold-start splash. Before this the launch window fell back to the generic system icon;
      now it shows the MotivBot robot on the brand green, then hands over to Theme.MotivBot.
    -->
    <style name="Theme.MotivBot.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/motivbot_green</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MotivBot</item>
    </style>
</resources>
