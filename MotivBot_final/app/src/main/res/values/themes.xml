<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MotivBot" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Cold-start splash: the sunrise icon on the sky colour, then Theme.MotivBot. -->
    <style name="Theme.MotivBot.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/motivbot_sky</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.MotivBot</item>
    </style>
</resources>
